// Inventory Management System — Prisma schema.
// Spec: docs/inventory/03-governance/22-entity-model.md (entities) + 07/08 (balances, ledger).
// Models are added slice by slice per docs/inventory/07-build/01-build-plan.md.
// Constraints Prisma can't express (CHECK >= 0, append-only triggers, NULLS NOT DISTINCT)
// go into hand-edited migrations: `npx prisma migrate dev --create-only`, edit SQL, then `migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Part 1: minimal masters ─────────────────────────
// Full catalog/warehouse models arrive in Part 3; auth fields in Part 2.

model Company {
  id        String   @id @default(uuid(7))
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at")

  users              User[]
  warehouses         Warehouse[]
  bins               Bin[]
  products           Product[]
  variants           ProductVariant[]
  batches            Batch[]
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  variantCosts       VariantCost[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  sequences          Sequence[]
  idempotencyRecords IdempotencyRecord[]
  reservations       Reservation[]
  roles              Role[]
  userRoles          UserRole[]
  userWarehouses     UserWarehouse[]
  settings           Setting[]
  categories         Category[]
  brands             Brand[]
  uoms               Uom[]
  suppliers          Supplier[]
  salesOrderRefs     SalesOrderRef[]
  notifications      Notification[]
  transfers          Transfer[]
  stockAdjustments   StockAdjustment[]
  approvals          Approval[]

  @@map("company")
}

// Better Auth reads/writes this model: field names are its contract, columns are ours.
model User {
  id               String        @id @default(uuid(7))
  companyId        String        @map("company_id")
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean?      @default(false) @map("two_factor_enabled")
  status           UserStatus    @default(active)
  isSystem         Boolean       @default(false) @map("is_system") // jobs actor, cannot log in
  isService        Boolean       @default(false) @map("is_service") // sales-channel API-key holder, cannot log in
  salesChannel     SalesChannel? @map("sales_channel") // service users: the channel their keys act as (SO-06)
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?     @map("locked_until")
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  company            Company           @relation(fields: [companyId], references: [id])
  sessions           Session[]
  accounts           Account[]
  twofactors         TwoFactor[]
  roles              UserRole[]
  warehouses         UserWarehouse[]
  managedWarehouses  Warehouse[]       @relation("WarehouseManager")
  createdPos         PurchaseOrder[]   @relation("PoCreator")
  poApprovals        PoApproval[]      @relation("PoApprover")
  receipts           GoodsReceipt[]    @relation("ReceiptReceiver")
  createdTransfers   Transfer[]        @relation("TransferCreator")
  createdAdjustments StockAdjustment[] @relation("AdjustmentCreator")
  approvals          Approval[]        @relation("Approver")

  @@unique([companyId, id])
  @@index([companyId])
  @@map("user")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum MasterStatus {
  active
  inactive
  archived

  @@map("master_status")
}

// Product/variant lifecycle (doc 23): draft → active ↔ inactive → discontinued → archived.
enum VariantStatus {
  draft
  active
  inactive
  discontinued
  archived

  @@map("variant_status")
}

enum BinType {
  sellable
  receiving
  quarantine
  damaged

  @@map("bin_type")
}

model Warehouse {
  id            String       @id @default(uuid(7))
  companyId     String       @map("company_id")
  code          String
  name          String
  address       String?
  managerUserId String?      @map("manager_user_id")
  status        MasterStatus @default(active)
  version       Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at")

  company            Company                    @relation(fields: [companyId], references: [id])
  manager            User?                      @relation("WarehouseManager", fields: [companyId, managerUserId], references: [companyId, id])
  bins               Bin[]
  variantSettings    VariantWarehouseSettings[]
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  variantCosts       VariantCost[]
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]
  userWarehouses     UserWarehouse[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  serialUnits        SerialUnit[]
  transfersOut       Transfer[]                 @relation("TransferFrom")
  transfersIn        Transfer[]                 @relation("TransferTo")
  stockAdjustments   StockAdjustment[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("warehouse")
}

model Bin {
  id                 String   @id @default(uuid(7))
  companyId          String   @map("company_id")
  warehouseId        String   @map("warehouse_id")
  code               String
  type               BinType
  // Optional location levels (doc 06 §1): plain codes, the bin tree groups by them.
  zone               String?
  rack               String?
  shelf              String?
  isDefaultSellable  Boolean  @default(false) @map("is_default_sellable")
  isDefaultReceiving Boolean  @default(false) @map("is_default_receiving")
  archived           Boolean  @default(false)
  version            Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")

  company            Company               @relation(fields: [companyId], references: [id])
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id])
  stockBalances      StockBalance[]
  inventoryMovements InventoryMovement[]
  receiptLines       ReceiptLine[]
  serialUnits        SerialUnit[]
  adjustmentLines    StockAdjustmentLine[]

  @@unique([warehouseId, code])
  @@map("bin")
}

enum ProductType {
  simple
  variant_parent

  @@map("product_type")
}

// Doc 04 §2. product_type, base_uom, is_serialized, requires_batch/expiry are frozen
// after the first movement (P-CAT-05) — enforced in src/server/catalog.
model Product {
  id                     String        @id @default(uuid(7))
  companyId              String        @map("company_id")
  name                   String
  description            String?
  brandId                String?       @map("brand_id")
  categoryId             String?       @map("category_id")
  type                   ProductType   @default(simple)
  status                 VariantStatus @default(active)
  requiresBatch          Boolean       @default(false) @map("requires_batch")
  requiresExpiry         Boolean       @default(false) @map("requires_expiry")
  isSerialized           Boolean       @default(false) @map("is_serialized")
  requiresInspection     Boolean       @default(false) @map("requires_inspection")
  baseUom                String        @default("each") @map("base_uom")
  trackExpiryDefaultDays Int?          @map("track_expiry_default_days")
  tags                   String[]      @default([])
  version                Int           @default(0)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  uom         Uom              @relation(fields: [companyId, baseUom], references: [companyId, code])
  variants    ProductVariant[]
  conversions UomConversion[]

  @@index([companyId])
  @@index([categoryId])
  @@map("product")
}

model ProductVariant {
  id                 String        @id @default(uuid(7))
  companyId          String        @map("company_id")
  productId          String        @map("product_id")
  sku                String // upper-case (CHECK in SQL), immutable once transacted (P-CAT-01)
  barcode            String?
  name               String? // e.g. "Red / M"; the product name when null
  attributes         Json          @default("{}")
  requiresInspection Boolean       @default(false) @map("requires_inspection")
  costPrice          Decimal?      @map("cost_price") @db.Decimal(18, 4)
  sellPrice          Decimal?      @map("sell_price") @db.Decimal(18, 4)
  minSellPrice       Decimal?      @map("min_sell_price") @db.Decimal(18, 4)
  weightKg           Decimal?      @map("weight_kg") @db.Decimal(18, 4)
  lengthCm           Decimal?      @map("length_cm") @db.Decimal(18, 4)
  widthCm            Decimal?      @map("width_cm") @db.Decimal(18, 4)
  heightCm           Decimal?      @map("height_cm") @db.Decimal(18, 4)
  status             VariantStatus @default(active)
  version            Int           @default(0)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")

  company            Company                    @relation(fields: [companyId], references: [id])
  product            Product                    @relation(fields: [productId], references: [id])
  skuAliases         SkuAlias[]
  barcodeAliases     BarcodeAlias[]
  images             ProductImage[]
  warehouseSettings  VariantWarehouseSettings[]
  supplierProducts   SupplierProduct[]
  batches            Batch[]
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  variantCosts       VariantCost[]
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]
  poLines            PoLine[]
  receiptLines       ReceiptLine[]
  serialUnits        SerialUnit[]
  transferLines      TransferLine[]
  adjustmentLines    StockAdjustmentLine[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@map("product_variant")
}

model Batch {
  id         String    @id @default(uuid(7))
  companyId  String    @map("company_id")
  variantId  String    @map("variant_id")
  batchNo    String    @map("batch_no")
  mfgDate    DateTime? @map("mfg_date") @db.Date
  expiryDate DateTime? @map("expiry_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")

  company            Company               @relation(fields: [companyId], references: [id])
  variant            ProductVariant        @relation(fields: [variantId], references: [id])
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  inventoryMovements InventoryMovement[]
  reservationLines   ReservationLine[]
  receiptLines       ReceiptLine[]
  serialUnits        SerialUnit[]
  transferLines      TransferLine[]
  adjustmentLines    StockAdjustmentLine[]

  @@unique([variantId, batchNo])
  @@map("batch")
}

// ───────────────────────── Part 1: ledger ─────────────────────────
// Only src/server/inventory/ writes stock_balance, stock_allocation,
// inventory_movement, variant_cost. Position keys with nullable batch_id are
// UNIQUE NULLS NOT DISTINCT and live in the migration SQL.

// Physical buckets per bin (doc 07 §2). No reserved, no in_transit.
model StockBalance {
  id          String   @id @default(uuid(7))
  companyId   String   @map("company_id")
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  binId       String   @map("bin_id")
  batchId     String?  @map("batch_id")
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 4)
  blocked     Decimal  @default(0) @db.Decimal(18, 4)
  damaged     Decimal  @default(0) @db.Decimal(18, 4)
  expired     Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  bin       Bin            @relation(fields: [binId], references: [id])
  batch     Batch?         @relation(fields: [batchId], references: [id])

  // Re-created NULLS NOT DISTINCT in the migration SQL.
  @@unique([variantId, warehouseId, binId, batchId], map: "stock_balance_position_key")
  @@index([companyId, variantId, warehouseId])
  @@map("stock_balance")
}

// One row per reservable position (variant, warehouse, batch?). The ATP lock target.
model StockAllocation {
  id          String   @id @default(uuid(7))
  companyId   String   @map("company_id")
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  batchId     String?  @map("batch_id")
  qtyReserved Decimal  @default(0) @map("qty_reserved") @db.Decimal(18, 4)
  version     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  batch     Batch?         @relation(fields: [batchId], references: [id])

  // Re-created NULLS NOT DISTINCT in the migration SQL.
  @@unique([variantId, warehouseId, batchId], map: "stock_allocation_position_key")
  @@index([companyId, variantId, warehouseId])
  @@map("stock_allocation")
}

// Moving-average cost per (variant, warehouse) — doc 15. WAC = value / qty, where qty
// counts every physical bucket (on_hand+blocked+damaged+expired). Keeping value (not a
// rounded WAC) makes SUM(movement.value_delta) == live value exactly (INV-022).
model VariantCost {
  companyId   String   @map("company_id")
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  qty         Decimal  @default(0) @db.Decimal(18, 4)
  value       Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@id([variantId, warehouseId])
  @@map("variant_cost")
}

enum MovementType {
  opening_balance
  purchase_receipt
  sale_fulfilment
  sale_return_quarantine
  sale_return_restock
  purchase_return
  transfer_out
  transfer_in
  transfer_variance
  adjustment_in
  adjustment_out
  cost_correction
  damage
  repair_to_stock
  expiry
  disposal
  reservation
  reservation_release
  blocked_in
  blocked_release
  blocked_reject
  putaway_out
  putaway_in

  @@map("movement_type")
}

// Append-only ledger (doc 08). Signed per-bucket deltas make replay a plain SUM.
model InventoryMovement {
  id                 String       @id @default(uuid(7))
  companyId          String       @map("company_id")
  variantId          String       @map("variant_id")
  warehouseId        String       @map("warehouse_id")
  binId              String?      @map("bin_id")
  batchId            String?      @map("batch_id")
  type               MovementType
  dOnHand            Decimal      @default(0) @map("d_on_hand") @db.Decimal(18, 4)
  dBlocked           Decimal      @default(0) @map("d_blocked") @db.Decimal(18, 4)
  dDamaged           Decimal      @default(0) @map("d_damaged") @db.Decimal(18, 4)
  dExpired           Decimal      @default(0) @map("d_expired") @db.Decimal(18, 4)
  dReserved          Decimal      @default(0) @map("d_reserved") @db.Decimal(18, 4)
  onHandAfter        Decimal?     @map("on_hand_after") @db.Decimal(18, 4)
  blockedAfter       Decimal?     @map("blocked_after") @db.Decimal(18, 4)
  damagedAfter       Decimal?     @map("damaged_after") @db.Decimal(18, 4)
  expiredAfter       Decimal?     @map("expired_after") @db.Decimal(18, 4)
  reservedAfter      Decimal      @map("reserved_after") @db.Decimal(18, 4)
  unitCost           Decimal?     @map("unit_cost_snapshot") @db.Decimal(18, 4)
  valueDelta         Decimal      @default(0) @map("value_delta") @db.Decimal(18, 4)
  sourceType         String       @map("source_type")
  sourceId           String       @map("source_id")
  reversesMovementId String?      @map("reverses_movement_id")
  reasonCode         String       @map("reason_code")
  note               String?
  actorId            String       @map("actor_id")
  channel            String?
  idempotencyKey     String       @map("idempotency_key")
  createdAt          DateTime     @default(now()) @map("created_at")

  company   Company             @relation(fields: [companyId], references: [id])
  variant   ProductVariant      @relation(fields: [variantId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  bin       Bin?                @relation(fields: [binId], references: [id])
  batch     Batch?              @relation(fields: [batchId], references: [id])
  reverses  InventoryMovement?  @relation("Reversal", fields: [reversesMovementId], references: [id])
  reversals InventoryMovement[] @relation("Reversal")

  @@unique([companyId, idempotencyKey])
  @@index([companyId, variantId, warehouseId, createdAt])
  @@index([companyId, sourceType, sourceId])
  @@map("inventory_movement")
}

model AuditLog {
  id             String   @id @default(uuid(7))
  companyId      String   @map("company_id")
  at             DateTime @default(now())
  actorId        String   @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  warehouseId    String?  @map("warehouse_id")
  before         Json?
  after          Json?
  reason         String?
  channel        String?
  requestId      String?  @map("request_id")
  idempotencyKey String?  @map("idempotency_key")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, at])
  @@map("audit_log")
}

// Per-company document numbering, allocated inside the posting transaction.
model Sequence {
  companyId String @map("company_id")
  name      String
  next      BigInt @default(1)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, name])
  @@map("sequences")
}

// Client Idempotency-Key → stored response (MV-02 layer 1).
model IdempotencyRecord {
  companyId   String   @map("company_id")
  key         String
  scope       String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("idempotency_record")
}

// ───────────────────────── Part 1: reservations ─────────────────────────

enum ReservationStatus {
  active
  partially_fulfilled
  fulfilled
  cancelled
  expired

  @@map("reservation_status")
}

model Reservation {
  id              String            @id @default(uuid(7))
  companyId       String            @map("company_id")
  variantId       String            @map("variant_id")
  warehouseId     String            @map("warehouse_id")
  qty             Decimal           @db.Decimal(18, 4)
  qtyFulfilled    Decimal           @default(0) @map("qty_fulfilled") @db.Decimal(18, 4)
  qtyReleased     Decimal           @default(0) @map("qty_released") @db.Decimal(18, 4)
  status          ReservationStatus @default(active)
  expiresAt       DateTime          @map("expires_at")
  salesOrderRefId String?           @map("sales_order_ref_id")
  ttlSeconds      Int               @map("ttl_seconds") // TTL applied at reserve; the extension reuses it (SO-08)
  extendedAt      DateTime?         @map("extended_at") // max 1 extension
  version         Int               @default(0)
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id])
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  order     SalesOrderRef?    @relation(fields: [companyId, salesOrderRefId], references: [companyId, id])
  lines     ReservationLine[]

  @@index([companyId, status, expiresAt])
  @@index([salesOrderRefId])
  @@map("reservation")
}

// FEFO batch pinning: one line per batch (batch_id null for untracked variants).
model ReservationLine {
  id            String  @id @default(uuid(7))
  reservationId String  @map("reservation_id")
  batchId       String? @map("batch_id")
  qty           Decimal @db.Decimal(18, 4)
  qtyFulfilled  Decimal @default(0) @map("qty_fulfilled") @db.Decimal(18, 4)
  qtyReleased   Decimal @default(0) @map("qty_released") @db.Decimal(18, 4)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  batch       Batch?      @relation(fields: [batchId], references: [id])

  @@map("reservation_line")
}

// ───────────────────────── Part 2: auth (Better Auth) ─────────────────────────
// Shapes dictated by Better Auth 1.7 (`npx @better-auth/cli generate`); columns snake_cased.

model Session {
  id        String   @id @default(uuid(7))
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7))
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

// referenceId = the service user the key acts as (doc 02 §6).
model Apikey {
  id                  String    @id @default(uuid(7))
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id")
  prefix              String?
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at")
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @default(86400000) @map("rate_limit_time_window")
  rateLimitMax        Int?      @default(10) @map("rate_limit_max")
  requestCount        Int?      @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ───────────────────────── Part 2: RBAC + settings (doc 02) ─────────────────────────

// Canonical grant list (doc 02 §2). role_permission FKs it, so unknown codes are rejected by the DB.
model Permission {
  code            String  @id
  warehouseScoped Boolean @default(false) @map("warehouse_scoped")

  roles RolePermission[]

  @@map("permission")
}

model Role {
  id            String   @id @default(uuid(7))
  companyId     String   @map("company_id")
  code          String
  name          String
  isSystem      Boolean  @default(false) @map("is_system")
  allWarehouses Boolean  @default(false) @map("all_warehouses") // ★ in doc 02 §5.1
  requires2fa   Boolean  @default(false) @map("requires_2fa")
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("role")
}

model RolePermission {
  roleId         String   @map("role_id")
  permissionCode String   @map("permission_code")
  limitAmount    Decimal? @map("limit_amount") @db.Decimal(18, 2)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

// company_id + composite FKs: users only get roles/warehouses of their own company (doc 22).
model UserRole {
  companyId String @map("company_id")
  userId    String @map("user_id")
  roleId    String @map("role_id")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [companyId, userId], references: [companyId, id])
  role    Role    @relation(fields: [companyId, roleId], references: [companyId, id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserWarehouse {
  companyId   String @map("company_id")
  userId      String @map("user_id")
  warehouseId String @map("warehouse_id")

  company   Company   @relation(fields: [companyId], references: [id])
  user      User      @relation(fields: [companyId, userId], references: [companyId, id])
  warehouse Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id])

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

// Company settings (doc 25): key → JSON value. Defaults + validation live in src/server/settings.
model Setting {
  companyId String   @map("company_id")
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("settings")
}

// ───────────────────────── Part 3: catalog (doc 04) ─────────────────────────

// Tree, max depth 5, no cycles (src/server/catalog/taxonomy.ts, under a per-company
// advisory lock). `path` = "/Electronics/Phones/" (names; rewritten on move/rename).
model Category {
  id        String   @id @default(uuid(7))
  companyId String   @map("company_id")
  parentId  String?  @map("parent_id")
  name      String
  path      String
  depth     Int // 1 = root
  sort      Int      @default(0)
  archived  Boolean  @default(false)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  company  Company    @relation(fields: [companyId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  // Re-created NULLS NOT DISTINCT (unique root names) in the migration SQL.
  @@unique([companyId, parentId, name], map: "category_sibling_name_key")
  @@map("category")
}

// Name unique per company, case-insensitive (lower(name) index in the migration SQL).
model Brand {
  id        String   @id @default(uuid(7))
  companyId String   @map("company_id")
  name      String
  logoUrl   String?  @map("logo_url")
  archived  Boolean  @default(false)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@map("brand")
}

enum UomType {
  count
  weight
  volume
  length

  @@map("uom_type")
}

model Uom {
  companyId String   @map("company_id")
  code      String
  name      String
  type      UomType
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@id([companyId, code])
  @@map("uom")
}

// 1 `uom` = factor × the product's base UOM, from effective_from on (P-CAT-08). A change
// is a new row; history is never rewritten. Movements snapshot the factor used (Part 4).
model UomConversion {
  id            String   @id @default(uuid(7))
  companyId     String   @map("company_id")
  productId     String   @map("product_id")
  uom           String
  factor        Decimal  @db.Decimal(18, 6)
  effectiveFrom DateTime @map("effective_from")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, uom, effectiveFrom])
  @@map("uom_conversion")
}

// P-CAT-01: a retired SKU keeps resolving to its successor variant.
model SkuAlias {
  companyId String   @map("company_id")
  oldSku    String   @map("old_sku")
  variantId String   @map("variant_id")
  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@id([companyId, oldSku])
  @@map("sku_alias")
}

// P-CAT-02: a replaced barcode still scans until expires_at.
model BarcodeAlias {
  id        String   @id @default(uuid(7))
  companyId String   @map("company_id")
  barcode   String
  variantId String   @map("variant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([companyId, barcode])
  @@map("barcode_alias")
}

// ponytail: URL only; file uploads (allowlist, size caps, edge #28) come with imports (Part 8).
model ProductImage {
  id        String   @id @default(uuid(7))
  companyId String   @map("company_id")
  variantId String   @map("variant_id")
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
  @@map("product_image")
}

// Reorder thresholds are per warehouse (doc 22, edge #37).
model VariantWarehouseSettings {
  companyId    String   @map("company_id")
  variantId    String   @map("variant_id")
  warehouseId  String   @map("warehouse_id")
  reorderPoint Decimal? @map("reorder_point") @db.Decimal(18, 4)
  reorderQty   Decimal? @map("reorder_qty") @db.Decimal(18, 4)
  maxStock     Decimal? @map("max_stock") @db.Decimal(18, 4)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@id([variantId, warehouseId])
  @@map("variant_warehouse_settings")
}

// ───────────────────────── Part 3: suppliers (doc 05) ─────────────────────────

enum PaymentTerms {
  net15
  net30
  net60
  prepaid
  cod

  @@map("payment_terms")
}

enum AddressType {
  billing
  shipping
  primary

  @@map("address_type")
}

model Supplier {
  id                  String       @id @default(uuid(7))
  companyId           String       @map("company_id")
  code                String // SUP-0001, from `sequences`
  name                String
  status              MasterStatus @default(active)
  taxId               String?      @map("tax_id")
  paymentTerms        PaymentTerms @default(net30) @map("payment_terms")
  creditLimit         Decimal?     @map("credit_limit") @db.Decimal(18, 2)
  currency            String // SUP-05: PO currency = supplier currency
  leadTimeDays        Int?         @map("lead_time_days")
  notes               String?
  requiresInspection  Boolean      @default(false) @map("requires_inspection")
  receiptTolerancePct Decimal?     @map("receipt_tolerance_pct") @db.Decimal(5, 2) // PO-10; null = company setting
  version             Int          @default(0)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")

  company        Company            @relation(fields: [companyId], references: [id])
  contacts       SupplierContact[]
  addresses      SupplierAddress[]
  products       SupplierProduct[]
  documents      SupplierDocument[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@map("supplier")
}

// Never deleted (INV-005); "remove" archives.
model SupplierContact {
  id         String   @id @default(uuid(7))
  supplierId String   @map("supplier_id")
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_contact")
}

model SupplierAddress {
  id         String      @id @default(uuid(7))
  supplierId String      @map("supplier_id")
  type       AddressType
  line1      String
  line2      String?
  city       String
  postalCode String?     @map("postal_code")
  country    String
  archived   Boolean     @default(false)
  createdAt  DateTime    @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_address")
}

// SUP-03: last_price is informational; PO lines snapshot their own price.
model SupplierProduct {
  supplierId  String   @map("supplier_id")
  variantId   String   @map("variant_id")
  supplierSku String?  @map("supplier_sku")
  lastPrice   Decimal? @map("last_price") @db.Decimal(18, 4)
  minOrderQty Decimal? @map("min_order_qty") @db.Decimal(18, 4)
  leadDays    Int?     @map("lead_days")
  isPreferred Boolean  @default(false) @map("is_preferred")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@id([supplierId, variantId])
  @@map("supplier_product")
}

// ponytail: URL only, like product_image.
model SupplierDocument {
  id         String   @id @default(uuid(7))
  supplierId String   @map("supplier_id")
  type       String
  fileUrl    String   @map("file_url")
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("supplier_document")
}

// ───────────────────────── Part 4: purchasing + receiving ─────────────────────────
// Docs 09/10/14, state machine doc 23. Lines and receipts are never deleted (PO-09, MV-05).

enum PoStatus {
  draft
  submitted
  approved
  ordered
  partially_received
  fully_received
  closed
  cancelled

  @@map("po_status")
}

model PurchaseOrder {
  id           String    @id @default(uuid(7))
  companyId    String    @map("company_id")
  number       String // PO-YYYY-00001, immutable (PO-08)
  supplierId   String    @map("supplier_id")
  supplierName String    @map("supplier_name")
  warehouseId  String    @map("warehouse_id") // the one receiving warehouse (PO-06)
  status       PoStatus  @default(draft)
  currency     String // = supplier currency (SUP-05)
  subtotal     Decimal   @default(0) @db.Decimal(18, 4)
  discount     Decimal   @default(0) @db.Decimal(18, 4)
  tax          Decimal   @default(0) @db.Decimal(18, 4)
  shipping     Decimal   @default(0) @db.Decimal(18, 4)
  total        Decimal   @default(0) @db.Decimal(18, 4)
  expectedDate DateTime? @map("expected_date") @db.Date
  notes        String?
  closeReason  String?   @map("close_reason")
  createdBy    String    @map("created_by")
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  orderedAt    DateTime? @map("ordered_at")
  closedAt     DateTime? @map("closed_at")
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  creator   User           @relation("PoCreator", fields: [createdBy], references: [id])
  lines     PoLine[]
  approvals PoApproval[]
  receipts  GoodsReceipt[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([supplierId, status])
  @@index([warehouseId, status])
  @@map("purchase_order")
}

model PoLine {
  id              String  @id @default(uuid(7))
  poId            String  @map("po_id")
  lineNo          Int     @map("line_no")
  variantId       String  @map("variant_id")
  sku             String // snapshots
  name            String
  orderUom        String  @map("order_uom")
  uomFactor       Decimal @map("uom_factor") @db.Decimal(18, 6)
  qtyOrdered      Decimal @map("qty_ordered") @db.Decimal(18, 4) // in order_uom
  qtyOrderedBase  Decimal @map("qty_ordered_base") @db.Decimal(18, 4)
  qtyReceivedBase Decimal @default(0) @map("qty_received_base") @db.Decimal(18, 4) // accepted only (RC-03)
  qtyReturnedBase Decimal @default(0) @map("qty_returned_base") @db.Decimal(18, 4) // Part 7
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4) // per order_uom
  discountPct     Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxPct          Decimal @default(0) @map("tax_pct") @db.Decimal(5, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(18, 4)
  requiresBatch   Boolean @map("requires_batch")
  requiresExpiry  Boolean @map("requires_expiry")
  removed         Boolean @default(false)

  po           PurchaseOrder  @relation(fields: [poId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  receiptLines ReceiptLine[]

  @@unique([poId, lineNo])
  @@index([variantId])
  @@map("po_line")
}

model PoApproval {
  id        String   @id @default(uuid(7))
  poId      String   @map("po_id")
  actorId   String   @map("actor_id")
  decision  String // approved | rejected
  amount    Decimal  @db.Decimal(18, 4)
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  po    PurchaseOrder @relation(fields: [poId], references: [id])
  actor User          @relation("PoApprover", fields: [actorId], references: [id])

  @@index([poId])
  @@map("po_approval")
}

enum ExcessStatus {
  pending
  approved
  rejected
  reversed

  @@map("excess_status")
}

model GoodsReceipt {
  id                  String   @id @default(uuid(7))
  companyId           String   @map("company_id")
  number              String // GRN-YYYY-00001
  poId                String   @map("po_id")
  warehouseId         String   @map("warehouse_id")
  supplierRef         String?  @map("supplier_ref") // delivery note / invoice ref
  note                String?
  receivedBy          String   @map("received_by")
  receivedAt          DateTime @default(now()) @map("received_at")
  reversalOfReceiptId String?  @unique @map("reversal_of_receipt_id") // RC-08: one reversal per receipt
  idempotencyKey      String?  @map("idempotency_key")

  po         PurchaseOrder @relation(fields: [poId], references: [id])
  warehouse  Warehouse     @relation(fields: [warehouseId], references: [id])
  receiver   User          @relation("ReceiptReceiver", fields: [receivedBy], references: [id])
  reversalOf GoodsReceipt? @relation("ReceiptReversal", fields: [reversalOfReceiptId], references: [id])
  reversal   GoodsReceipt? @relation("ReceiptReversal")
  lines      ReceiptLine[]

  @@unique([companyId, number])
  @@index([poId])
  @@map("goods_receipt")
}

// Quantities are base units except order_qty (in order_uom).
model ReceiptLine {
  id               String        @id @default(uuid(7))
  receiptId        String        @map("receipt_id")
  lineNo           Int           @map("line_no")
  poLineId         String?       @map("po_line_id") // null for a wrong-product line
  variantId        String        @map("variant_id")
  wrongProduct     Boolean       @default(false) @map("wrong_product")
  held             Boolean       @default(true) // wrong product physically kept → blocked_in
  orderUom         String        @map("order_uom")
  uomFactor        Decimal       @map("uom_factor") @db.Decimal(18, 6) // snapshot (RC-06)
  orderQty         Decimal       @map("order_qty") @db.Decimal(18, 4)
  baseQty          Decimal       @map("base_qty") @db.Decimal(18, 4)
  qtyAccepted      Decimal       @default(0) @map("qty_accepted") @db.Decimal(18, 4)
  qtyDamaged       Decimal       @default(0) @map("qty_damaged") @db.Decimal(18, 4)
  qtyExpired       Decimal       @default(0) @map("qty_expired") @db.Decimal(18, 4)
  qtyExcessBlocked Decimal       @default(0) @map("qty_excess_blocked") @db.Decimal(18, 4)
  qtyMissing       Decimal       @default(0) @map("qty_missing") @db.Decimal(18, 4) // claim info, no movement
  inspection       Boolean       @default(false) // accepted went to blocked (RC-05)
  batchId          String?       @map("batch_id")
  binId            String        @map("bin_id")
  unitCost         Decimal?      @map("unit_cost") @db.Decimal(18, 4)
  note             String?
  excessStatus     ExcessStatus? @map("excess_status")
  excessDecidedBy  String?       @map("excess_decided_by")
  excessDecidedAt  DateTime?     @map("excess_decided_at")
  excessComment    String?       @map("excess_comment")

  receipt GoodsReceipt   @relation(fields: [receiptId], references: [id])
  poLine  PoLine?        @relation(fields: [poLineId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
  batch   Batch?         @relation(fields: [batchId], references: [id])
  bin     Bin            @relation(fields: [binId], references: [id])
  serials SerialUnit[]

  @@unique([receiptId, lineNo])
  @@index([poLineId])
  @@index([excessStatus])
  @@map("receipt_line")
}

enum SerialStatus {
  in_stock
  reserved
  sold
  in_transit
  quarantine
  damaged
  disposed
  returned_pending
  lost // missing in transit (approved transfer_variance)
  reversed

  @@map("serial_status")
}

// Doc 14 §3. One unit = one row (I-06). serial_no unique per company among
// non-reversed units (partial unique index in the migration SQL).
model SerialUnit {
  id             String       @id @default(uuid(7))
  companyId      String       @map("company_id")
  variantId      String       @map("variant_id")
  serialNo       String       @map("serial_no")
  batchId        String?      @map("batch_id")
  status         SerialStatus
  warehouseId    String       @map("warehouse_id")
  binId          String?      @map("bin_id")
  receiptLineId  String?      @map("receipt_line_id")
  transferLineId String?      @map("transfer_line_id") // last transfer that moved it
  version        Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  variant      ProductVariant @relation(fields: [variantId], references: [id])
  batch        Batch?         @relation(fields: [batchId], references: [id])
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  bin          Bin?           @relation(fields: [binId], references: [id])
  receiptLine  ReceiptLine?   @relation(fields: [receiptLineId], references: [id])
  transferLine TransferLine?  @relation(fields: [transferLineId], references: [id])

  @@index([variantId, warehouseId, status])
  @@map("serial_unit")
}

// ───────────────────────── Part 5: sales channels (doc 12) ─────────────────────────

enum SalesChannel {
  pos
  web
  marketplace
  api

  @@map("sales_channel")
}

// External order identity (SO-07). Status is derived from its reservations.
model SalesOrderRef {
  id              String       @id @default(uuid(7))
  companyId       String       @map("company_id")
  channel         SalesChannel
  externalOrderId String       @map("external_order_id")
  createdBy       String       @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")

  company      Company       @relation(fields: [companyId], references: [id])
  reservations Reservation[]

  @@unique([companyId, id])
  @@unique([companyId, channel, externalOrderId])
  @@map("sales_order_ref")
}

// Doc 17, stored only (N-03); notification center + email in Part 9. user_id null =
// everyone with access to warehouse_id (company-wide when that is null too).
model Notification {
  id          String    @id @default(uuid(7))
  companyId   String    @map("company_id")
  userId      String?   @map("user_id")
  warehouseId String?   @map("warehouse_id")
  type        String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  message     String
  link        String?
  actorId     String    @map("actor_id")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, userId, readAt])
  @@map("notification")
}

// ───────────────────────── Part 6: transfers, adjustments, approvals ─────────────────────────
// Docs 11, 23, 25 (Approvals Inbox). Build decisions: doc 11 §5.

enum TransferStatus {
  draft
  submitted
  approved
  in_transit
  partially_received
  completed
  closed_with_variance
  cancelled

  @@map("transfer_status")
}

model Transfer {
  id              String         @id @default(uuid(7))
  companyId       String         @map("company_id")
  number          String // TR-YYYY-00001
  fromWarehouseId String         @map("from_warehouse_id")
  toWarehouseId   String         @map("to_warehouse_id")
  status          TransferStatus @default(draft)
  notes           String?
  reason          String? // cancel reason
  createdBy       String         @map("created_by")
  approvedBy      String?        @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  shippedBy       String?        @map("shipped_by")
  shippedAt       DateTime?      @map("shipped_at")
  closedAt        DateTime?      @map("closed_at")
  version         Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id])
  fromWarehouse Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  creator       User           @relation("TransferCreator", fields: [createdBy], references: [id])
  lines         TransferLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([fromWarehouseId, status])
  @@index([toWarehouseId, status])
  @@map("transfer")
}

// Base units. In transit = shipped − received − damaged − missing (doc 07: derived, never stored).
model TransferLine {
  id                 String  @id @default(uuid(7))
  transferId         String  @map("transfer_id")
  lineNo             Int     @map("line_no")
  variantId          String  @map("variant_id")
  batchId            String? @map("batch_id")
  qtyRequested       Decimal @map("qty_requested") @db.Decimal(18, 4)
  qtyShipped         Decimal @default(0) @map("qty_shipped") @db.Decimal(18, 4)
  qtyReceived        Decimal @default(0) @map("qty_received") @db.Decimal(18, 4)
  qtyDamaged         Decimal @default(0) @map("qty_damaged") @db.Decimal(18, 4)
  qtyMissing         Decimal @default(0) @map("qty_missing") @db.Decimal(18, 4) // approved transfer_variance
  qtyMissingReported Decimal @default(0) @map("qty_missing_reported") @db.Decimal(18, 4) // awaiting approval
  shippedValue       Decimal @default(0) @map("shipped_value") @db.Decimal(18, 4) // relieved at source on ship
  settledValue       Decimal @default(0) @map("settled_value") @db.Decimal(18, 4) // admitted at dest + lost

  transfer Transfer       @relation(fields: [transferId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  batch    Batch?         @relation(fields: [batchId], references: [id])
  serials  SerialUnit[]

  @@unique([transferId, lineNo])
  @@index([variantId])
  @@map("transfer_line")
}

enum AdjustmentKind {
  adjustment // ± on_hand (found / loss / correction)
  damage // on_hand → damaged
  repair // damaged → on_hand
  disposal // − damaged | expired | blocked (terminal loss)

  @@map("adjustment_kind")
}

enum AdjustmentStatus {
  draft
  submitted
  approved
  applied
  cancelled

  @@map("adjustment_status")
}

model StockAdjustment {
  id          String           @id @default(uuid(7))
  companyId   String           @map("company_id")
  number      String // ADJ-YYYY-00001
  kind        AdjustmentKind
  warehouseId String           @map("warehouse_id")
  status      AdjustmentStatus @default(draft)
  reasonCode  String           @map("reason_code")
  note        String?
  createdBy   String           @map("created_by")
  approvedBy  String?          @map("approved_by")
  approvedAt  DateTime?        @map("approved_at")
  appliedBy   String?          @map("applied_by")
  appliedAt   DateTime?        @map("applied_at")
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  company   Company               @relation(fields: [companyId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  creator   User                  @relation("AdjustmentCreator", fields: [createdBy], references: [id])
  lines     StockAdjustmentLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([warehouseId, status])
  @@map("stock_adjustment")
}

// qty is signed for `adjustment` (+ in / − out) and > 0 for the other kinds.
model StockAdjustmentLine {
  id           String   @id @default(uuid(7))
  adjustmentId String   @map("adjustment_id")
  lineNo       Int      @map("line_no")
  variantId    String   @map("variant_id")
  batchId      String?  @map("batch_id")
  binId        String?  @map("bin_id") // null = picked at apply (out) / default sellable (in)
  qty          Decimal  @db.Decimal(18, 4)
  bucket       String? // disposal: damaged | expired | blocked
  unitCost     Decimal? @map("unit_cost") @db.Decimal(18, 4) // adjustment in; default current WAC
  serials      String[] // serialized units (damage / repair / disposal)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id])
  variant    ProductVariant  @relation(fields: [variantId], references: [id])
  batch      Batch?          @relation(fields: [batchId], references: [id])
  bin        Bin?            @relation(fields: [binId], references: [id])

  @@unique([adjustmentId, lineNo])
  @@index([variantId])
  @@map("stock_adjustment_line")
}

// Approval timeline for transfers, adjustments and transfer variances (POs keep po_approval).
model Approval {
  id         String   @id @default(uuid(7))
  companyId  String   @map("company_id")
  entityType String   @map("entity_type") // transfer | transfer_variance | stock_adjustment
  entityId   String   @map("entity_id")
  actorId    String   @map("actor_id")
  decision   String // approved | rejected
  amount     Decimal? @db.Decimal(18, 4)
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  actor   User    @relation("Approver", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("approval")
}
