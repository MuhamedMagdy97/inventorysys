// Inventory Management System — Prisma schema.
// Spec: docs/inventory/03-governance/22-entity-model.md (entities) + 07/08 (balances, ledger).
// Models are added slice by slice per docs/inventory/07-build/01-build-plan.md.
// Constraints Prisma can't express (CHECK >= 0, append-only triggers, NULLS NOT DISTINCT)
// go into hand-edited migrations: `npx prisma migrate dev --create-only`, edit SQL, then `migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Part 1: minimal masters ─────────────────────────
// Full catalog/warehouse models arrive in Part 3; auth fields in Part 2.

model Company {
  id        String   @id @default(uuid(7))
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at")

  users              User[]
  warehouses         Warehouse[]
  bins               Bin[]
  products           Product[]
  variants           ProductVariant[]
  batches            Batch[]
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  variantCosts       VariantCost[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  sequences          Sequence[]
  idempotencyRecords IdempotencyRecord[]
  reservations       Reservation[]
  roles              Role[]
  userRoles          UserRole[]
  userWarehouses     UserWarehouse[]
  settings           Setting[]

  @@map("company")
}

// Better Auth reads/writes this model: field names are its contract, columns are ours.
model User {
  id               String     @id @default(uuid(7))
  companyId        String     @map("company_id")
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean?   @default(false) @map("two_factor_enabled")
  status           UserStatus @default(active)
  isSystem         Boolean    @default(false) @map("is_system") // jobs actor, cannot log in
  isService        Boolean    @default(false) @map("is_service") // sales-channel API-key holder, cannot log in
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  version          Int        @default(0)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")

  company    Company         @relation(fields: [companyId], references: [id])
  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]
  roles      UserRole[]
  warehouses UserWarehouse[]

  @@unique([companyId, id])
  @@index([companyId])
  @@map("user")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum MasterStatus {
  active
  inactive
  archived

  @@map("master_status")
}

enum VariantStatus {
  active
  discontinued
  archived

  @@map("variant_status")
}

enum BinType {
  sellable
  receiving
  quarantine
  damaged

  @@map("bin_type")
}

model Warehouse {
  id        String       @id @default(uuid(7))
  companyId String       @map("company_id")
  code      String
  name      String
  status    MasterStatus @default(active)
  version   Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")

  company            Company             @relation(fields: [companyId], references: [id])
  bins               Bin[]
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  variantCosts       VariantCost[]
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]
  userWarehouses     UserWarehouse[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("warehouse")
}

model Bin {
  id                 String   @id @default(uuid(7))
  companyId          String   @map("company_id")
  warehouseId        String   @map("warehouse_id")
  code               String
  type               BinType
  isDefaultSellable  Boolean  @default(false) @map("is_default_sellable")
  isDefaultReceiving Boolean  @default(false) @map("is_default_receiving")
  archived           Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")

  company            Company             @relation(fields: [companyId], references: [id])
  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id])
  stockBalances      StockBalance[]
  inventoryMovements InventoryMovement[]

  @@unique([warehouseId, code])
  @@map("bin")
}

model Product {
  id             String        @id @default(uuid(7))
  companyId      String        @map("company_id")
  name           String
  status         VariantStatus @default(active)
  requiresBatch  Boolean       @default(false) @map("requires_batch")
  requiresExpiry Boolean       @default(false) @map("requires_expiry")
  isSerialized   Boolean       @default(false) @map("is_serialized")
  baseUom        String        @default("each") @map("base_uom")
  version        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at")

  company  Company          @relation(fields: [companyId], references: [id])
  variants ProductVariant[]

  @@index([companyId])
  @@map("product")
}

model ProductVariant {
  id        String        @id @default(uuid(7))
  companyId String        @map("company_id")
  productId String        @map("product_id")
  sku       String
  barcode   String?
  status    VariantStatus @default(active)
  version   Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")

  company            Company             @relation(fields: [companyId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  batches            Batch[]
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  variantCosts       VariantCost[]
  inventoryMovements InventoryMovement[]
  reservations       Reservation[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@map("product_variant")
}

model Batch {
  id         String    @id @default(uuid(7))
  companyId  String    @map("company_id")
  variantId  String    @map("variant_id")
  batchNo    String    @map("batch_no")
  mfgDate    DateTime? @map("mfg_date") @db.Date
  expiryDate DateTime? @map("expiry_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")

  company            Company             @relation(fields: [companyId], references: [id])
  variant            ProductVariant      @relation(fields: [variantId], references: [id])
  stockBalances      StockBalance[]
  stockAllocations   StockAllocation[]
  inventoryMovements InventoryMovement[]
  reservationLines   ReservationLine[]

  @@unique([variantId, batchNo])
  @@map("batch")
}

// ───────────────────────── Part 1: ledger ─────────────────────────
// Only src/server/inventory/ writes stock_balance, stock_allocation,
// inventory_movement, variant_cost. Position keys with nullable batch_id are
// UNIQUE NULLS NOT DISTINCT and live in the migration SQL.

// Physical buckets per bin (doc 07 §2). No reserved, no in_transit.
model StockBalance {
  id          String   @id @default(uuid(7))
  companyId   String   @map("company_id")
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  binId       String   @map("bin_id")
  batchId     String?  @map("batch_id")
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 4)
  blocked     Decimal  @default(0) @db.Decimal(18, 4)
  damaged     Decimal  @default(0) @db.Decimal(18, 4)
  expired     Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  bin       Bin            @relation(fields: [binId], references: [id])
  batch     Batch?         @relation(fields: [batchId], references: [id])

  // Re-created NULLS NOT DISTINCT in the migration SQL.
  @@unique([variantId, warehouseId, binId, batchId], map: "stock_balance_position_key")
  @@index([companyId, variantId, warehouseId])
  @@map("stock_balance")
}

// One row per reservable position (variant, warehouse, batch?). The ATP lock target.
model StockAllocation {
  id          String   @id @default(uuid(7))
  companyId   String   @map("company_id")
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  batchId     String?  @map("batch_id")
  qtyReserved Decimal  @default(0) @map("qty_reserved") @db.Decimal(18, 4)
  version     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  batch     Batch?         @relation(fields: [batchId], references: [id])

  // Re-created NULLS NOT DISTINCT in the migration SQL.
  @@unique([variantId, warehouseId, batchId], map: "stock_allocation_position_key")
  @@index([companyId, variantId, warehouseId])
  @@map("stock_allocation")
}

// Moving-average cost per (variant, warehouse) — doc 15. WAC = value / qty, where qty
// counts every physical bucket (on_hand+blocked+damaged+expired). Keeping value (not a
// rounded WAC) makes SUM(movement.value_delta) == live value exactly (INV-022).
model VariantCost {
  companyId   String   @map("company_id")
  variantId   String   @map("variant_id")
  warehouseId String   @map("warehouse_id")
  qty         Decimal  @default(0) @db.Decimal(18, 4)
  value       Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company        @relation(fields: [companyId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@id([variantId, warehouseId])
  @@map("variant_cost")
}

enum MovementType {
  opening_balance
  purchase_receipt
  sale_fulfilment
  sale_return_quarantine
  sale_return_restock
  purchase_return
  transfer_out
  transfer_in
  transfer_variance
  adjustment_in
  adjustment_out
  cost_correction
  damage
  repair_to_stock
  expiry
  disposal
  reservation
  reservation_release
  blocked_in
  blocked_release
  blocked_reject
  putaway_out
  putaway_in

  @@map("movement_type")
}

// Append-only ledger (doc 08). Signed per-bucket deltas make replay a plain SUM.
model InventoryMovement {
  id                 String       @id @default(uuid(7))
  companyId          String       @map("company_id")
  variantId          String       @map("variant_id")
  warehouseId        String       @map("warehouse_id")
  binId              String?      @map("bin_id")
  batchId            String?      @map("batch_id")
  type               MovementType
  dOnHand            Decimal      @default(0) @map("d_on_hand") @db.Decimal(18, 4)
  dBlocked           Decimal      @default(0) @map("d_blocked") @db.Decimal(18, 4)
  dDamaged           Decimal      @default(0) @map("d_damaged") @db.Decimal(18, 4)
  dExpired           Decimal      @default(0) @map("d_expired") @db.Decimal(18, 4)
  dReserved          Decimal      @default(0) @map("d_reserved") @db.Decimal(18, 4)
  onHandAfter        Decimal?     @map("on_hand_after") @db.Decimal(18, 4)
  blockedAfter       Decimal?     @map("blocked_after") @db.Decimal(18, 4)
  damagedAfter       Decimal?     @map("damaged_after") @db.Decimal(18, 4)
  expiredAfter       Decimal?     @map("expired_after") @db.Decimal(18, 4)
  reservedAfter      Decimal      @map("reserved_after") @db.Decimal(18, 4)
  unitCost           Decimal?     @map("unit_cost_snapshot") @db.Decimal(18, 4)
  valueDelta         Decimal      @default(0) @map("value_delta") @db.Decimal(18, 4)
  sourceType         String       @map("source_type")
  sourceId           String       @map("source_id")
  reversesMovementId String?      @map("reverses_movement_id")
  reasonCode         String       @map("reason_code")
  note               String?
  actorId            String       @map("actor_id")
  channel            String?
  idempotencyKey     String       @map("idempotency_key")
  createdAt          DateTime     @default(now()) @map("created_at")

  company   Company             @relation(fields: [companyId], references: [id])
  variant   ProductVariant      @relation(fields: [variantId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  bin       Bin?                @relation(fields: [binId], references: [id])
  batch     Batch?              @relation(fields: [batchId], references: [id])
  reverses  InventoryMovement?  @relation("Reversal", fields: [reversesMovementId], references: [id])
  reversals InventoryMovement[] @relation("Reversal")

  @@unique([companyId, idempotencyKey])
  @@index([companyId, variantId, warehouseId, createdAt])
  @@index([companyId, sourceType, sourceId])
  @@map("inventory_movement")
}

model AuditLog {
  id             String   @id @default(uuid(7))
  companyId      String   @map("company_id")
  at             DateTime @default(now())
  actorId        String   @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  warehouseId    String?  @map("warehouse_id")
  before         Json?
  after          Json?
  reason         String?
  channel        String?
  requestId      String?  @map("request_id")
  idempotencyKey String?  @map("idempotency_key")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, at])
  @@map("audit_log")
}

// Per-company document numbering, allocated inside the posting transaction.
model Sequence {
  companyId String @map("company_id")
  name      String
  next      BigInt @default(1)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, name])
  @@map("sequences")
}

// Client Idempotency-Key → stored response (MV-02 layer 1).
model IdempotencyRecord {
  companyId   String   @map("company_id")
  key         String
  scope       String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("idempotency_record")
}

// ───────────────────────── Part 1: reservations ─────────────────────────

enum ReservationStatus {
  active
  partially_fulfilled
  fulfilled
  cancelled
  expired

  @@map("reservation_status")
}

model Reservation {
  id           String            @id @default(uuid(7))
  companyId    String            @map("company_id")
  variantId    String            @map("variant_id")
  warehouseId  String            @map("warehouse_id")
  qty          Decimal           @db.Decimal(18, 4)
  qtyFulfilled Decimal           @default(0) @map("qty_fulfilled") @db.Decimal(18, 4)
  qtyReleased  Decimal           @default(0) @map("qty_released") @db.Decimal(18, 4)
  status       ReservationStatus @default(active)
  expiresAt    DateTime          @map("expires_at")
  orderRef     String?           @map("order_ref")
  version      Int               @default(0)
  createdBy    String            @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  company   Company           @relation(fields: [companyId], references: [id])
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  lines     ReservationLine[]

  @@index([companyId, status, expiresAt])
  @@map("reservation")
}

// FEFO batch pinning: one line per batch (batch_id null for untracked variants).
model ReservationLine {
  id            String  @id @default(uuid(7))
  reservationId String  @map("reservation_id")
  batchId       String? @map("batch_id")
  qty           Decimal @db.Decimal(18, 4)
  qtyFulfilled  Decimal @default(0) @map("qty_fulfilled") @db.Decimal(18, 4)
  qtyReleased   Decimal @default(0) @map("qty_released") @db.Decimal(18, 4)

  reservation Reservation @relation(fields: [reservationId], references: [id])
  batch       Batch?      @relation(fields: [batchId], references: [id])

  @@map("reservation_line")
}

// ───────────────────────── Part 2: auth (Better Auth) ─────────────────────────
// Shapes dictated by Better Auth 1.7 (`npx @better-auth/cli generate`); columns snake_cased.

model Session {
  id        String   @id @default(uuid(7))
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(uuid(7))
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

// referenceId = the service user the key acts as (doc 02 §6).
model Apikey {
  id                  String    @id @default(uuid(7))
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id")
  prefix              String?
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at")
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @default(86400000) @map("rate_limit_time_window")
  rateLimitMax        Int?      @default(10) @map("rate_limit_max")
  requestCount        Int?      @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @map("created_at")
  updatedAt           DateTime  @map("updated_at")
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ───────────────────────── Part 2: RBAC + settings (doc 02) ─────────────────────────

// Canonical grant list (doc 02 §2). role_permission FKs it, so unknown codes are rejected by the DB.
model Permission {
  code            String  @id
  warehouseScoped Boolean @default(false) @map("warehouse_scoped")

  roles RolePermission[]

  @@map("permission")
}

model Role {
  id            String   @id @default(uuid(7))
  companyId     String   @map("company_id")
  code          String
  name          String
  isSystem      Boolean  @default(false) @map("is_system")
  allWarehouses Boolean  @default(false) @map("all_warehouses") // ★ in doc 02 §5.1
  requires2fa   Boolean  @default(false) @map("requires_2fa")
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("role")
}

model RolePermission {
  roleId         String   @map("role_id")
  permissionCode String   @map("permission_code")
  limitAmount    Decimal? @map("limit_amount") @db.Decimal(18, 2)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

// company_id + composite FKs: users only get roles/warehouses of their own company (doc 22).
model UserRole {
  companyId String @map("company_id")
  userId    String @map("user_id")
  roleId    String @map("role_id")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [companyId, userId], references: [companyId, id])
  role    Role    @relation(fields: [companyId, roleId], references: [companyId, id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserWarehouse {
  companyId   String @map("company_id")
  userId      String @map("user_id")
  warehouseId String @map("warehouse_id")

  company   Company   @relation(fields: [companyId], references: [id])
  user      User      @relation(fields: [companyId, userId], references: [companyId, id])
  warehouse Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id])

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

// Company settings (doc 25): key → JSON value. Defaults + validation live in src/server/settings.
model Setting {
  companyId String   @map("company_id")
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("settings")
}
