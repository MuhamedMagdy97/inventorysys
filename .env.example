# Copy to .env and adjust. Local values match docker-compose.yml.
DATABASE_URL="postgresql://inventory:inventory@localhost:5433/inventory?schema=public"
TEST_DATABASE_URL="postgresql://inventory:inventory@localhost:5433/inventory_test?schema=public"
# Better Auth: secret signs session cookies (generate: `npx @better-auth/cli secret`). Never commit the real one.
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"
# Password for the dev seed users (admin@demo.local, manager@demo.local), ≥ 10 chars.
SEED_PASSWORD="demo-password-123"
# Browser origins allowed to call /api cross-origin (comma-separated, no wildcard). Empty = same origin only.
CORS_ORIGINS=""
# Production only (scripts/backup.sh): backup encryption passphrase, from the secret store.
# BACKUP_PASSPHRASE=""
